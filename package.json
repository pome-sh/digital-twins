{
  "name": "pome-monorepo",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*",
    "cli"
  ],
  "packageManager": "npm@11.5.1",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm run test --workspaces --if-present",
    "test:contract": "node contract/run.mjs",
    "test:pack": "node scripts/clean-room-pack-test.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "typecheck:examples": "node scripts/typecheck-examples.mjs",
    "smoke:examples": "node scripts/smoke-examples.mjs",
    "probe:examples": "node scripts/probe-example-tools.mjs",
    "lint:no-cloud-imports": "bash scripts/lint-no-cloud-imports.sh",
    "gate:no-eval": "node scripts/no-eval-in-oss.mjs",
    "gate:no-native": "node scripts/no-native-modules.mjs",
    "lint:no-catch": "node scripts/no-catch-and-continue.mjs",
    "lint:copy-markers": "node scripts/check-copy-markers.mjs",
    "lint:code-health": "node scripts/lint-code-health.mjs",
    "lint:legacy-markers": "node scripts/lint-legacy-criterion-markers.mjs",
    "lint:parent-vocab": "node scripts/lint-parent-vocab.mjs",
    "lint:skill-manifest": "node scripts/check-plugin-manifest-lists-every-skill.mjs",
    "lint:dead-code": "knip --no-config-hints",
    "gate:bundled-deps": "node scripts/check-bundled-runtime-deps.mjs"
  },
  "engines": {
    "node": ">=24",
    "npm": ">=11.5.1"
  },
  "devDependencies": {
    "knip": "^6.31.0"
  },
  "overrides": {
    "hono": "^4.13.0",
    "fast-uri": "^3.1.5"
  }
}
