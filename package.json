{
  "name": "pome-monorepo",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*",
    "cli"
  ],
  "packageManager": "npm@11.5.1",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "test:contract": "node contract/run.mjs",
    "gate:golden": "vitest run --project cli cli/test/golden",
    "test:pack": "node scripts/clean-room-pack-test.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "typecheck:examples": "node scripts/typecheck-examples.mjs",
    "smoke:examples": "node scripts/smoke-examples.mjs",
    "probe:examples": "node scripts/probe-example-tools.mjs",
    "probe:twins": "node scripts/probe-twin-endpoints.mjs",
    "capture:mcp-tools-list": "node scripts/capture-mcp-tools-list.mjs",
    "gate:mcp-tools-list": "node scripts/capture-mcp-tools-list.mjs --check --offline",
    "lint:no-cloud-imports": "bash scripts/lint-no-cloud-imports.sh",
    "gate:no-eval": "node scripts/no-eval-in-oss.mjs",
    "gate:no-native": "node scripts/no-native-modules.mjs",
    "lint:no-catch": "node scripts/no-catch-and-continue.mjs",
    "lint:copy-markers": "node scripts/check-copy-markers.mjs",
    "lint:code-health": "node scripts/lint-code-health.mjs",
    "lint:legacy-markers": "node scripts/lint-legacy-criterion-markers.mjs",
    "lint:task-format-doc": "node scripts/lint-task-format-doc.mjs",
    "lint:parent-vocab": "node scripts/lint-parent-vocab.mjs",
    "lint:task-class": "node scripts/lint-task-class.mjs",
    "lint:skill-manifest": "node scripts/check-plugin-manifest-lists-every-skill.mjs",
    "lint:twin-chunks": "node scripts/check-twin-chunk-laziness.mjs",
    "lint:twin-leaves": "node scripts/check-twin-leaf-portability.mjs",
    "lint:route-inputs": "node scripts/lint-route-input-declarations.mjs",
    "emit:route-inputs": "node scripts/emit-route-inputs.mjs",
    "gate:route-inputs": "node scripts/emit-route-inputs.mjs --check",
    "lint:dead-code": "knip --no-config-hints",
    "lint:import-meta-main": "node scripts/lint-no-bare-import-meta-main.mjs",
    "lint:example-isolation": "node scripts/check-example-sdk-isolation.mjs",
    "gate:bundled-deps": "node scripts/check-bundled-runtime-deps.mjs",
    "gate:wire-tarball": "node scripts/ci/check-wire-tarball.mjs",
    "gate:wire-manifest": "node scripts/ci/check-wire-tarball.mjs --manifest-only",
    "gate:checks-tarball": "node scripts/ci/check-checks-tarball.mjs",
    "gate:checks-manifest": "node scripts/ci/check-checks-tarball.mjs --manifest-only",
    "gate:sandbox-domains-tarball": "node scripts/ci/check-sandbox-domains-tarball.mjs",
    "gate:sandbox-domains-manifest": "node scripts/ci/check-sandbox-domains-tarball.mjs --manifest-only"
  },
  "engines": {
    "node": ">=24",
    "npm": ">=11.5.1"
  },
  "devDependencies": {
    "knip": "^6.31.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "hono": "^4.13.0",
    "fast-uri": "^3.1.5",
    "esbuild": "^0.28.1"
  }
}
