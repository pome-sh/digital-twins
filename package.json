{
  "name": "pome-monorepo",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*",
    "cli"
  ],
  "packageManager": "npm@11.19.1",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "test:contract": "node contract/run.mjs",
    "gate:golden": "vitest run --project cli cli/test/golden",
    "test:pack": "node scripts/clean-room-pack-test.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "gate:examples": "node scripts/gate-examples.mjs",
    "smoke:examples": "node scripts/smoke-examples.mjs",
    "lint": "node scripts/lint.mjs",
    "lint:test": "node scripts/lint.mjs --run-tests",
    "probe:examples": "node scripts/probe-example-tools.mjs",
    "probe:twins": "node scripts/probe-twin-endpoints.mjs",
    "capture:mcp-tools-list": "node scripts/capture-mcp-tools-list.mjs",
    "gate:mcp-tools-list": "node scripts/capture-mcp-tools-list.mjs --check --offline",
    "lint:no-cloud-imports": "bash scripts/lint-no-cloud-imports.sh",
    "emit:route-inputs": "node scripts/emit-route-inputs.mjs",
    "gate:route-inputs": "node scripts/emit-route-inputs.mjs --check",
    "emit:example-catalog": "node scripts/emit-example-catalog.mjs",
    "gate:example-catalog": "node scripts/emit-example-catalog.mjs --check",
    "lint:dead-code": "knip --no-config-hints",
    "gate:wire-tarball": "node scripts/ci/check-wire-tarball.mjs",
    "gate:wire-manifest": "node scripts/ci/check-wire-tarball.mjs --manifest-only",
    "gate:checks-tarball": "node scripts/ci/check-checks-tarball.mjs",
    "gate:checks-manifest": "node scripts/ci/check-checks-tarball.mjs --manifest-only",
    "gate:sandbox-domains-tarball": "node scripts/ci/check-sandbox-domains-tarball.mjs",
    "gate:sandbox-domains-manifest": "node scripts/ci/check-sandbox-domains-tarball.mjs --manifest-only"
  },
  "engines": {
    "node": ">=24.20.0",
    "npm": ">=11.19.1"
  },
  "devDependencies": {
    "knip": "^6.34.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "hono": "^4.13.5",
    "fast-uri": "^3.1.6",
    "esbuild": "^0.28.2"
  }
}
