{
  "name": "@pome-sh/cli",
  "version": "0.20.0",
  "description": "Digital-twin testing for AI agents — run tasks against resettable local or hosted twins and record tool-call traces for evaluation on pome.sh.",
  "keywords": [
    "ai",
    "agents",
    "agent-testing",
    "digital-twin",
    "llm",
    "evals",
    "claude",
    "anthropic",
    "github",
    "stripe",
    "cli"
  ],
  "homepage": "https://pome.sh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pome-sh/digital-twins.git",
    "directory": "cli"
  },
  "bugs": {
    "url": "https://github.com/pome-sh/digital-twins/issues"
  },
  "author": "Pome <founders@pome.sh> (https://pome.sh)",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "pome": "./dist/src/cli/main.js"
  },
  "files": [
    "dist",
    "assets",
    "examples",
    "tasks",
    "LICENSE",
    "package.json",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli/main.ts",
    "pome": "node dist/src/cli/main.js",
    "prepublishOnly": "node scripts/assert-publishable.mjs && npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "vitest run test/e2e",
    "gate:no-eval": "node ../scripts/no-eval-in-oss.mjs",
    "gate:no-native": "node ../scripts/no-native-modules.mjs --root .",
    "gate:recorder-overhead": "tsx scripts/recorder-overhead-gate.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.9",
    "@ai-sdk/gateway": "^4.0.28",
    "@ai-sdk/google": "^4.0.9",
    "@ai-sdk/openai": "^4.0.8",
    "@anthropic-ai/sdk": "^0.110.0",
    "@hono/node-server": "^2.0.10",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "ai": "^7.0.18",
    "commander": "^15.0.0",
    "graphql": "^16.11.0",
    "hono": "^4.10.7",
    "yaml": "^2.8.2",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@pome-sh/sdk": "*",
    "@pome-sh/shared-types": "*",
    "@pome-sh/wire": "*",
    "@pome-sh/twin-github": "*",
    "@pome-sh/twin-gmail": "*",
    "@pome-sh/twin-linear": "*",
    "@pome-sh/twin-slack": "*",
    "@pome-sh/twin-stripe": "*",
    "@types/node": "^26.0.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "tsup": "^8.5.0"
  },
  "engines": {
    "node": ">=24"
  }
}
