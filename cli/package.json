{
  "name": "@pome-sh/cli",
  "version": "0.45.1",
  "description": "Test mode for your integrations, built for the way agents build. Local, stateful twins of GitHub, Slack, Stripe, Gmail and Linear, over REST and MCP.",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude-code",
    "codex",
    "testing",
    "test-mode",
    "sandbox",
    "api-mocking",
    "digital-twin",
    "ai-agents",
    "github",
    "slack",
    "stripe",
    "gmail",
    "linear",
    "cli"
  ],
  "homepage": "https://pome.sh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pome-sh/digital-twins.git",
    "directory": "cli"
  },
  "bugs": {
    "url": "https://github.com/pome-sh/digital-twins/issues"
  },
  "author": "Pome <founders@pome.sh> (https://pome.sh)",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "pome": "./dist/src/cli/main.js"
  },
  "files": [
    "dist",
    "assets",
    "examples",
    "tasks",
    "LICENSE",
    "package.json",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli/main.ts",
    "pome": "node dist/src/cli/main.js",
    "prepublishOnly": "node scripts/assert-publishable.mjs && npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "gate:recorder-overhead": "tsx scripts/recorder-overhead-gate.ts",
    "gate:agent-trace-overhead": "tsx scripts/overhead-gate.ts",
    "emit:manifest-schema": "node scripts/emit-manifest-schema.mjs",
    "check:manifest-schema": "node scripts/emit-manifest-schema.mjs --check"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.54",
    "@ai-sdk/gateway": "^4.0.82",
    "@ai-sdk/google": "^4.0.72",
    "@ai-sdk/openai": "^4.0.67",
    "@anthropic-ai/sdk": "^0.126.0",
    "@hono/node-server": "^2.1.1",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "ai": "^7.0.102",
    "commander": "^15.0.0",
    "graphql": "^16.14.2",
    "hono": "^4.13.8",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@pome-sh/dashboard": "*",
    "@pome-sh/sdk": "*",
    "@pome-sh/wire": "*",
    "@pome-sh/twin-github": "*",
    "@pome-sh/twin-gmail": "*",
    "@pome-sh/twin-linear": "*",
    "@pome-sh/twin-slack": "*",
    "@pome-sh/twin-stripe": "*",
    "@types/node": "^26.6.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1",
    "tsup": "^8.5.1"
  },
  "engines": {
    "node": ">=24"
  }
}
