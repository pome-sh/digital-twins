{
  "name": "@pome-sh/twin-github",
  "version": "0.10.7",
  "description": "Deterministic GitHub-shaped twin for agent testing \u2014 REST + MCP, SQLite-backed state.",
  "private": true,
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./server": {
      "types": "./dist/src/server.d.ts",
      "default": "./dist/src/server.js"
    },
    "./checks": {
      "types": "./dist/src/checks.d.ts",
      "default": "./dist/src/checks.js"
    },
    "./seed": {
      "types": "./dist/src/seed.d.ts",
      "default": "./dist/src/seed.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "FIDELITY.md",
    "fidelity.inventory.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/server.ts",
    "seed": "tsx scripts/seed.ts",
    "smoke": "tsx scripts/smoke.ts",
    "validate:mcp": "tsx scripts/validate-mcp.ts",
    "fixture:mcp": "tsx scripts/adopt-upstream-mcp-fixture.ts",
    "gate:mcp-fixture": "tsx scripts/adopt-upstream-mcp-fixture.ts --check",
    "agent:claude": "tsx examples/claude-github-agent.ts",
    "review:harness": "tsx scripts/review-harness.ts",
    "start": "node dist/src/server.js",
    "prepack": "npm run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "capture:fixtures": "tsx scripts/capture-gh-fixtures.ts",
    "fidelity:parity": "tsx scripts/fidelity-parity.ts",
    "regenerate:mcp-tool-fixture": "tsx scripts/regenerate-mcp-tool-fixture.ts",
    "gate:mcp-tool-fixture": "tsx scripts/regenerate-mcp-tool-fixture.ts --check"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.0",
    "@pome-sh/sdk": "*",
    "@pome-sh/wire": "*",
    "hono": "^4.13.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@octokit/openapi-types": "^28.0.0",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "tsx": "^4.23.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "keywords": [
    "github",
    "twin",
    "test-double",
    "agent-testing",
    "mcp",
    "pome"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pome-sh/digital-twins.git",
    "directory": "packages/twin-github"
  },
  "homepage": "https://github.com/pome-sh/digital-twins/tree/main/packages/twin-github",
  "bugs": {
    "url": "https://github.com/pome-sh/digital-twins/issues"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  }
}
