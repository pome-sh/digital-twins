    },
    "create_pull_request_review": {
      "operationId": "pulls/create-review"
    },
    "create_repository": {
      "byArgument": {
        "argument": "owner",
        "present": "repos/create-in-org",
        "absent": "repos/create-for-authenticated-user"
      }
    },
    "delete_file": {
      "operationId": "repos/delete-file"
    },
    "fork_repository": {
