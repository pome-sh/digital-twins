{
  "name": "@pome-sh/sdk",
  "version": "0.11.6",
  "description": "Twin engine for Pome digital twins \u2014 defineTwin() + serve(): HTTP mounting, bearer auth, trace recorder, MCP dispatch, SQLite-backed state.",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./parity": {
      "types": "./dist/parity.d.ts",
      "default": "./dist/parity.js"
    },
    "./checks": {
      "types": "./dist/checks.d.ts",
      "default": "./dist/checks.js"
    },
    "./db": {
      "types": "./dist/db.d.ts",
      "default": "./dist/db.js"
    },
    "./route-inputs": {
      "types": "./dist/route-inputs.d.ts",
      "default": "./dist/route-inputs.js"
    },
    "./mcp-tool-fixture": {
      "types": "./dist/mcp-tool-fixture.d.ts",
      "default": "./dist/mcp-tool-fixture.js"
    },
    "./failure-injection-rules": {
      "types": "./dist/failure-injection-rules.d.ts",
      "default": "./dist/failure-injection-rules.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pome-sh/digital-twins.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/pome-sh/digital-twins/tree/main/packages/sdk",
  "bugs": {
    "url": "https://github.com/pome-sh/digital-twins/issues"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "tsc -p tsconfig.build.json",
    "emit-fidelity": "tsx scripts/emit-fidelity.ts"
  },
  "dependencies": {
    "@pome-sh/wire": "*",
    "hono": "^4.13.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@hono/node-server": "^2.0.8"
  },
  "peerDependenciesMeta": {
    "@hono/node-server": {
      "optional": true
    }
  },
  "devDependencies": {
    "@hono/node-server": "^2.1.0",
    "@types/node": "^26.1.2",
    "tsx": "^4.23.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24"
  }
}
