{
  "name": "@pome-sh/sandbox-domains",
  "version": "0.2.6",
  "description": "Pome's twin domain layer — the in-process runtime a bound check reads: each digital twin's domain object, its SQLite opener, its seed parser and its declared check vocabulary. Runtime, not server: no Hono app, no routes, no MCP tool table.",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./github": {
      "types": "./dist/github.d.ts",
      "default": "./dist/github.js"
    },
    "./gmail": {
      "types": "./dist/gmail.d.ts",
      "default": "./dist/gmail.js"
    },
    "./linear": {
      "types": "./dist/linear.d.ts",
      "default": "./dist/linear.js"
    },
    "./slack": {
      "types": "./dist/slack.d.ts",
      "default": "./dist/slack.js"
    },
    "./stripe": {
      "types": "./dist/stripe.d.ts",
      "default": "./dist/stripe.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "package.json",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pome-sh/digital-twins.git",
    "directory": "packages/sandbox-domains"
  },
  "homepage": "https://github.com/pome-sh/digital-twins/tree/main/packages/sandbox-domains",
  "bugs": {
    "url": "https://github.com/pome-sh/digital-twins/issues"
  },
  "license": "Apache-2.0",
  "keywords": [
    "pome",
    "agent-testing",
    "evaluation",
    "grading",
    "digital-twin",
    "runtime"
  ],
  "scripts": {
    "build": "tsup && node ../../scripts/bundle-declarations.mjs . --external hono --external @octokit/openapi-types --external stripe",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@octokit/openapi-types": "^28.0.0",
    "hono": "^4.13.0",
    "stripe": "22.3.2"
  },
  "peerDependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@pome-sh/sdk": "*",
    "@pome-sh/twin-github": "*",
    "@pome-sh/twin-gmail": "*",
    "@pome-sh/twin-linear": "*",
    "@pome-sh/twin-slack": "*",
    "@pome-sh/twin-stripe": "*",
    "@types/node": "^26.1.2",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=24"
  }
}
