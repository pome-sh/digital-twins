{
  "name": "@pome-sh/twin-slack",
  "version": "0.4.1",
  "description": "Deterministic Slack Web API twin for agent testing \u2014 REST + MCP, SQLite-backed state.",
  "private": true,
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./server": {
      "types": "./dist/src/server.d.ts",
      "default": "./dist/src/server.js"
    },
    "./checks": {
      "types": "./dist/src/checks.d.ts",
      "default": "./dist/src/checks.js"
    },
    "./seed": {
      "types": "./dist/src/seed.d.ts",
      "default": "./dist/src/seed.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "FIDELITY.md",
    "fidelity.inventory.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/server.ts",
    "seed": "tsx scripts/seed.ts",
    "smoke": "tsx scripts/smoke.ts",
    "validate:mcp": "tsx scripts/validate-mcp.ts",
    "fixture:mcp": "tsx scripts/adopt-upstream-mcp-fixture.ts",
    "gate:mcp-fixture": "tsx scripts/adopt-upstream-mcp-fixture.ts --check",
    "verify:cloud-token": "tsx scripts/verify-cloud-token.ts",
    "agent:claude": "tsx examples/claude-slack-agent.ts",
    "start": "node dist/src/server.js",
    "prepack": "npm run build",
    "test:coverage": "vitest run --config vitest.coverage.config.ts --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "fidelity:parity": "tsx scripts/fidelity-parity.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@pome-sh/sdk": "*",
    "@pome-sh/wire": "*",
    "hono": "^4.13.5",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@slack/web-api": "^8.1.1",
    "@types/node": "^26.4.1",
    "@vitest/coverage-v8": "4.1.11",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "keywords": [
    "slack",
    "twin",
    "test-double",
    "agent-testing",
    "mcp",
    "pome"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pome-sh/digital-twins.git",
    "directory": "packages/twin-slack"
  },
  "homepage": "https://github.com/pome-sh/digital-twins/tree/main/packages/twin-slack",
  "bugs": {
    "url": "https://github.com/pome-sh/digital-twins/issues"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.20.0"
  }
}
