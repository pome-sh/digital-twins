{
  "name": "@pome-sh/twin-gmail",
  "version": "0.4.0",
  "description": "Deterministic Gmail-shaped twin for agent testing — SQLite-backed domain core.",
  "private": true,
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./server": {
      "types": "./dist/src/server.d.ts",
      "default": "./dist/src/server.js"
    },
    "./checks": {
      "types": "./dist/src/checks.d.ts",
      "default": "./dist/src/checks.js"
    },
    "./seed": {
      "types": "./dist/src/seed.d.ts",
      "default": "./dist/src/seed.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "REFERENCE-DIVERGENCES.md",
    "LIMITS.md",
    "CHANGELOG.md",
    "HOSTED.md",
    "fidelity.inventory.json",
    "fixtures"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/server.ts",
    "start": "node dist/src/server.js",
    "prepack": "npm run build",
    "test": "node --test test/gate0-fixtures.test.mjs && vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "fixture:mcp": "tsx scripts/adopt-upstream-mcp-fixture.ts",
    "gate:mcp-fixture": "tsx scripts/adopt-upstream-mcp-fixture.ts --check",
    "fidelity:parity": "tsx scripts/fidelity-parity.ts",
    "preview:drift": "tsx scripts/preview-drift.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.0",
    "@pome-sh/sdk": "*",
    "hono": "^4.13.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@googleapis/gmail": "18.0.0",
    "@types/node": "^26.1.2",
    "tsx": "^4.23.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "keywords": [
    "gmail",
    "twin",
    "test-double",
    "agent-testing",
    "pome",
    "mcp"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pome-sh/digital-twins.git",
    "directory": "packages/twin-gmail"
  },
  "homepage": "https://github.com/pome-sh/digital-twins/tree/main/packages/twin-gmail",
  "bugs": {
    "url": "https://github.com/pome-sh/digital-twins/issues"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  }
}
