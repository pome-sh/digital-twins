{
  "name": "@pome-sh/dashboard",
  "version": "0.1.0",
  "description": "The local twin dashboard: a browser view of a running twin's tape, built to static assets and served by `pome twin start`.",
  "private": true,
  "type": "module",
  "exports": {
    "./api": "./src/api.ts"
  },
  "scripts": {
