{
  "name": "@pome-sh/twin-stripe",
  "version": "0.4.7",
  "description": "Deterministic test double for Stripe x402 machine payments \u2014 stateful clone agents can drive without burning sandbox quota or real chain gas.",
  "private": true,
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./server": {
      "types": "./dist/src/server.d.ts",
      "default": "./dist/src/server.js"
    },
    "./checks": {
      "types": "./dist/src/checks.d.ts",
      "default": "./dist/src/checks.js"
    },
    "./seed": {
      "types": "./dist/src/seed.d.ts",
      "default": "./dist/src/seed.js"
    },
    "./package.json": "./package.json",
    "./x402": {
      "types": "./dist/src/x402.d.ts",
      "default": "./dist/src/x402.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "FIDELITY.md",
    "fidelity.inventory.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/server.ts",
    "seed": "tsx scripts/seed.ts",
    "smoke": "npm run build && tsx scripts/smoke.ts",
    "start": "node dist/src/server.js",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "fidelity:parity": "tsx scripts/fidelity-parity.ts"
  },
  "keywords": [
    "stripe",
    "x402",
    "twin",
    "test-double",
    "agent-testing",
    "pome",
    "machine-payments"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pome-sh/digital-twins.git",
    "directory": "packages/twin-stripe"
  },
  "homepage": "https://github.com/pome-sh/digital-twins/tree/main/packages/twin-stripe",
  "bugs": {
    "url": "https://github.com/pome-sh/digital-twins/issues"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@pome-sh/sdk": "*",
    "@pome-sh/wire": "*",
    "hono": "^4.13.5",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/node": "^26.4.1",
    "stripe": "22.6.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24.20.0"
  }
}
