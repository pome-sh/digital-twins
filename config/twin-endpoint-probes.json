      {
        "tool": "create_branch",
        "args": {
          "owner": "acme",
          "repo": "api",
          "branch": "probe-merge"
        }
      },
      {
        "tool": "create_or_update_file",
        "args": {
          "owner": "acme",
          "repo": "api",
          "branch": "probe-merge",
          "path": "probe.ts",
          "message": "Add probe file",
          "content": "export const probe = true;\n"
        }
      },
      {
        "tool": "push_files",
        "args": {
          "owner": "acme",
          "repo": "api",
          "branch": "probe-merge",
          "message": "Push probe files",
          "files": [
            {
              "path": "probe-2.ts",
              "content": "export const probe2 = true;\n"
            }
          ]
        }
      },
      {
        "tool": "create_pull_request",
        "args": {
          "owner": "acme",
          "repo": "api",
          "title": "F-1305 probe PR",
          "head": "probe-merge",
          "base": "main"
        },
        "as": "merge_pr"
      },
      {
        "tool": "pull_request_read",
        "args": {
          "method": "get",
          "owner": "acme",
          "repo": "api",
          "pullNumber": "$merge_pr.number"
        }
      },
      {
        "tool": "list_pull_requests",
        "args": {
          "owner": "acme",
          "repo": "api",
          "state": "all"
        }
      },
      {
        "tool": "create_pull_request_review",
        "args": {
          "owner": "acme",
          "repo": "api",
          "pull_number": "$merge_pr.number",
          "event": "COMMENT",
          "body": "F-1305 probe review."
        }
      },
      {
        "tool": "pull_request_review_write",
        "args": {
          "method": "create",
          "owner": "acme",
          "repo": "api",
          "pullNumber": "$merge_pr.number",
          "event": "COMMENT",
          "body": "F-1305 probe review via GitHub's consolidated writer"
        }
      },
      {
        "note": "F-1151 regression fixture. `comment_on_pull_request` in examples/pr-summary-agent and examples/pr-summary-review wrapped add_issue_comment at a PULL REQUEST's number, and the twin answered `404 Issue not found` for every one of those calls, on every subject, for as long as the examples existed. The issue-number probe above cannot see that class: it comments on issue #1, which always worked. This is the same tool at a pull request's number.",
        "tool": "add_issue_comment",
        "args": {
          "owner": "acme",
          "repo": "api",
          "issue_number": "$merge_pr.number",
          "body": "F-1305 probe comment on a pull request."
        },
        "as": "pr_number_comment"
      },
      {
        "tool": "update_pull_request_branch",
        "args": {
          "owner": "acme",
          "repo": "api",
          "pull_number": "$merge_pr.number"
        }
      },
      {
        "tool": "merge_pull_request",
        "args": {
          "owner": "acme",
          "repo": "api",
          "pull_number": "$merge_pr.number"
        }
      },
      {
        "tool": "create_branch",
        "args": {
          "owner": "acme",
          "repo": "api",
          "branch": "probe-review"
        }
      },
      {
        "tool": "create_or_update_file",
        "args": {
          "owner": "acme",
          "repo": "api",
          "branch": "probe-review",
          "path": "review.ts",
          "message": "Add review file",
          "content": "export const review = true;\n"
        }
      },
      {
        "tool": "create_pull_request",
        "args": {
          "owner": "acme",
          "repo": "api",
          "title": "F-1305 probe review PR",
          "head": "probe-review",
          "base": "main"
        },
        "as": "review_pr"
      },
      {
        "tool": "update_pull_request",
        "args": {
          "owner": "acme",
          "repo": "api",
          "pull_number": "$review_pr.number",
          "title": "F-1305 probe review PR (updated)"
        }
      },
      {
        "setup": {
          "method": "POST",
          "path": "/repos/acme/api/pulls/$review_pr.number/comments",
          "body": {
            "body": "F-1305 probe inline comment.",
            "path": "review.ts",
            "line": 1
          }
        },
        "as": "inline_comment",
        "why": "GitHub declares no create_pull_request_review_comment MCP tool (F-1376), so the reply tool's subject is built over the REST route the twin still serves"
      },
      {
        "tool": "add_reply_to_pull_request_comment",
        "args": {
          "owner": "acme",
          "repo": "api",
          "pull_number": "$review_pr.number",
          "comment_id": "$inline_comment.id",
          "body": "F-1305 probe reply."
        }
      },
      {
        "tool": "create_branch",
        "args": {
          "owner": "acme",
          "repo": "api",
          "branch": "probe-scratch"
        }
      },
      {
        "tool": "create_or_update_file",
        "args": {
          "owner": "acme",
          "repo": "api",
          "branch": "probe-scratch",
          "path": "scratch.txt",
          "message": "Add scratch",
          "content": "scratch\n"
        },
        "as": "scratch_file"
      },
      {
        "tool": "delete_file",
        "args": {
          "owner": "acme",
          "repo": "api",
          "branch": "probe-scratch",
          "path": "scratch.txt",
          "message": "Drop scratch",
          "sha": "$scratch_file.content.sha"
        }
      },
      {
        "setup": {
          "method": "POST",
          "path": "/repos/acme/api/releases",
          "body": {
            "tag_name": "v1.0.0-probe",
            "name": "F-1305 probe release",
            "body": "F-1305 probe"
          }
        },
        "why": "GitHub declares no create_release MCP tool (F-1376); the three release readers below still need one to exist"
      },
      {
        "tool": "list_releases",
        "args": {
          "owner": "acme",
          "repo": "api"
        }
      },
      {
        "tool": "get_latest_release",
        "args": {
          "owner": "acme",
          "repo": "api"
        }
      },
      {
        "tool": "get_release_by_tag",
        "args": {
          "owner": "acme",
          "repo": "api",
          "tag": "v1.0.0-probe"
        }
      },
      {
        "tool": "list_tags",
        "args": {
          "owner": "acme",
          "repo": "api"
        }
      },
      {
        "tool": "get_tag",
        "args": {
          "owner": "acme",
          "repo": "api",
          "tag": "v1.0.0-probe"
        }
      }
