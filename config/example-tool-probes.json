{
  "gmail-retry-notify": {
    "module": "src/index.ts",
    "export": "buildTools",
    "config": {
      "restUrl": "$gmail.rest",
      "authToken": "$token"
    },
    "probes": [
      {
        "tool": "list_sent",
        "args": {}
      },
      {
        "tool": "send_email",
        "args": {
          "to": "dana@pome-twin.test",
          "subject": "F-1152 probe",
          "body": "F-1152 probe."
        }
      }
    ]
  },
  "merge-agent": {
    "module": "src/index.ts",
    "export": "buildTools",
    "config": {
      "restUrl": "$github.rest",
      "authToken": "$token"
    },
    "probes": [
      {
        "tool": "list_open_pull_requests",
        "args": {
          "owner": "$repo.owner",
          "repo": "$repo.name"
        }
      },
      {
        "tool": "get_pull_request",
        "args": {
          "owner": "$repo.owner",
          "repo": "$repo.name",
          "number": "$pr.number"
        }
      },
      {
        "tool": "get_pull_request_files",
        "args": {
          "owner": "$repo.owner",
          "repo": "$repo.name",
          "number": "$pr.number"
        }
      },
      {
        "tool": "list_collaborators",
        "args": {
          "owner": "$repo.owner",
          "repo": "$repo.name"
        }
      },
      {
        "tool": "search_users",
        "args": {
          "q": "GaganSD"
        }
      },
      {
        "tool": "request_changes",
        "args": {
          "owner": "$repo.owner",
          "repo": "$repo.name",
          "number": "$pr.number",
          "body": "F-1152 probe."
        }
      },
      {
        "tool": "merge_pull_request",
        "args": {
          "owner": "$repo.owner",
          "repo": "$repo.name",
          "number": "$pr.number"
        }
      }
    ]
  },
  "minimal-viktor": {
    "module": "src/index.ts",
    "export": "buildTools",
    "config": {
      "ghUrl": "$github.rest",
      "ghToken": "$token",
      "slackUrl": "$slack.rest",
      "slackToken": "$token"
    },
    "probes": [
      {
        "tool": "list_open_pull_requests",
        "args": {
          "owner": "$repo.owner",
          "repo": "$repo.name"
        }
      },
      {
        "tool": "get_pull_request",
        "args": {
          "owner": "$repo.owner",
          "repo": "$repo.name",
          "number": "$pr.number"
        }
      },
      {
        "tool": "get_pull_request_files",
        "args": {
          "owner": "$repo.owner",
          "repo": "$repo.name",
          "number": "$pr.number"
        }
      },
      {
        "tool": "get_pull_request_status",
        "args": {
          "owner": "$repo.owner",
          "repo": "$repo.name",
          "number": "$pr.number"
        }
      },
      {
        "tool": "get_file_contents",
        "args": {
          "owner": "$repo.owner",
          "repo": "$repo.name",
          "path": "$file.path",
          "ref": "$file.ref"
        }
      },
      {
        "tool": "list_collaborators",
        "args": {
          "owner": "$repo.owner",
          "repo": "$repo.name"
        }
      },
      {
        "tool": "slack_search_channels",
        "args": {
          "query": "eng"
        }
      },
      {
        "tool": "slack_send_message",
        "args": {
          "channel_id": "eng-alerts",
          "message": "F-1152 probe."
        }
      },
      {
        "tool": "request_changes",
        "args": {
          "owner": "$repo.owner",
          "repo": "$repo.name",
          "number": "$pr.number",
          "body": "F-1152 probe."
        }
      },
      {
        "tool": "merge_pull_request",
        "args": {
          "owner": "$repo.owner",
          "repo": "$repo.name",
          "number": "$pr.number"
        },
        "expect_status_by_seed": {
          "tasks/03-failing-ci.seed.json": 409
        },
        "why": "tasks/03-failing-ci.seed.json sets ci/test to failure on purpose, so the real GitHub 409s a merge behind a failing required status check"
      }
    ]
  },
