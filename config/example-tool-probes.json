  "triage-agent": {
    "module": "src/index.ts",
    "export": "buildTwinTools",
    "config": {
      "mcpUrl": "$github.mcp",
      "token": "$token"
    },
    "probes": [
      {
        "tool": "list_open_issues",
        "args": {
          "owner": "$repo.owner",
          "repo": "$repo.name"
        }
      },
      {
        "tool": "add_label",
        "args": {
          "owner": "$repo.owner",
          "repo": "$repo.name",
          "issue_number": "$issue.number",
          "label": "bug"
        }
      },
      {
        "tool": "comment_on_issue",
        "args": {
          "owner": "$repo.owner",
          "repo": "$repo.name",
          "issue_number": "$issue.number",
          "body": "F-1152 probe."
        }
      },
      {
        "tool": "close_issue",
        "args": {
          "owner": "$repo.owner",
          "repo": "$repo.name",
          "issue_number": "$issue.number"
        }
      }
