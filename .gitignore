# Dependencies
node_modules/

# Build output
dist/
*.tsbuildinfo

# Test coverage
coverage/

# Logs
*.log

# Environment / secrets
.env
.env.*
!.env.example
# release.yml writes the GitHub Packages token to $HOME/.npmrc precisely so it
# never sits in the workspace; a laptop following the same steps writes it here.
.npmrc
# The pome-ops-push App private key, which can push to protected main and
# trigger a publish. Rotating it means downloading one.
*.pem

# Local twin state (SQLite-backed runtime data). Unanchored: direct twin
# boots (cwd = package root) self-generate .pome-data/<twin>/secret.
.pome-data/
.pome/
.stripe_clone/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Run artifacts (recorded traces, eval matrices)
runs/
matrix-results/
.audit/

# Tooling / agents — local-only, never committed to the OSS repo.
# Agent config/skills/rules live in the pome-cloud repo, not here.
.gstack/
.claude/
.cursor/
.vscode/
.zed/
# Local MCP server config. The repo ships none: a committed one can only work
# for whoever already has access to every server it names.
/.mcp.json

# OS / editor
.DS_Store
Thumbs.db
.idea/
*.swp
__pycache__/
*.pyc
*.pyo
.venv/

# Local Claude Code symlink to AGENTS.md (not part of the OSS tree)
/CLAUDE.md
