# Dependencies
node_modules/

# Build output
dist/
*.tsbuildinfo
# The local dashboard's built page. `packages/dashboard` emits it straight into
# the directory `cli/package.json` ships via `files: ["assets"]` — generated at
# build time like `cli/dist`, and shipped the same way `cli/dist` is.
cli/assets/dashboard/

# Test coverage
coverage/

# Logs
*.log

# Environment / secrets
.env
.env.*
!.env.example
.npmrc
*.pem

# Local twin state (SQLite-backed runtime data). Unanchored: direct twin
# boots (cwd = package root) self-generate .pome-data/<twin>/secret.
.pome-data/
.pome/
.stripe_clone/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Run artifacts (recorded traces, eval matrices)
runs/
matrix-results/
.audit/

# Tooling / agents — local-only, never committed to the OSS repo.
# Agent config/skills/rules live in the pome-cloud repo, not here.
.gstack/
.claude/
.cursor/
.vscode/
.zed/
/.mcp.json

# OS / editor
.DS_Store
Thumbs.db
.idea/
*.swp
__pycache__/
*.pyc
*.pyo
.venv/

# Local Claude Code symlink to AGENTS.md (not part of the OSS tree)
/CLAUDE.md
