{
  "name": "@pome-sh/minimal-viktor-example",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Bundled Pome example: minimal-viktor, an MVP viktor.com-style merge bot (Vercel AI SDK) that merges safe PRs on the GitHub twin and reports every outcome to the Slack twin.",
  "scripts": {
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.116",
    "@ai-sdk/google": "^3.0.120",
    "@ai-sdk/openai": "^3.0.106",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-trace-node": "^2.11.0",
    "ai": "^6.0.275",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^25.9.5",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=24.20.0"
  },
  "overrides": {
    "undici": "^6.28.0"
  }
}
