{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "rules": {
    "files": "error",
    "dependencies": "error",
    "exports": "off",
    "types": "off",
    "duplicates": "off",
    "binaries": "off",
    "unlisted": "off"
  },
  "ignore": [
    "**/*.d.ts",
    "**/upstream-coverage.types.ts"
  ],
  "ignoreBinaries": [
    "docker",
    "gh",
    "security",
    "infisical"
  ],
  "ignoreExportsUsedInFile": true,
  "ignoreDependencies": [
    "@ai-sdk/anthropic",
    "@ai-sdk/gateway",
    "@ai-sdk/google",
    "@ai-sdk/openai",
    "@openrouter/ai-sdk-provider",
    "ai",
    "tsx",
    "graphql"
  ],
  "workspaces": {
    ".": {
      "entry": [
        "scripts/*.{mjs,sh}",
        "scripts/ci/*.{mjs,sh}",
        "scripts/fixtures/**/*.mjs",
        "contract/run.mjs",
        "contract/*.test.mjs"
      ],
      "project": [
        "scripts/**/*.{mjs,sh}",
        "contract/**/*.mjs"
      ]
    },
    "packages/*": {
      "entry": [
        "src/index.ts",
        "src/server.ts",
        "tsup.config.ts",
        "scripts/**/*.ts"
      ],
      "project": [
        "src/**/*.ts",
        "test/**/*.ts",
        "scripts/**/*.ts"
      ]
    },
    "packages/sdk": {
      "entry": [
        "src/index.ts",
        "src/server.ts",
        "src/parity.ts",
        "src/checks.ts",
        "scripts/**/*.ts"
      ],
      "project": [
        "src/**/*.ts",
        "test/**/*.ts",
        "scripts/**/*.ts"
      ]
    },
    "packages/checks": {
      "entry": [
        "src/index.ts",
        "src/dsl.ts",
        "src/github.ts",
        "src/gmail.ts",
        "src/linear.ts",
        "src/slack.ts",
        "src/stripe.ts",
        "tsup.config.ts",
        "test/**/*.test.ts"
      ],
      "project": [
        "src/**/*.ts",
        "test/**/*.ts"
      ]
    },
    "packages/sandbox-domains": {
      "entry": [
        "src/index.ts",
        "src/github.ts",
        "src/gmail.ts",
        "src/linear.ts",
        "src/slack.ts",
        "src/stripe.ts",
        "src/server.ts",
        "tsup.config.ts",
        "test/**/*.test.ts"
      ],
      "project": [
        "src/**/*.ts",
        "test/**/*.ts"
      ],
      "ignoreDependencies": [
        "@octokit/openapi-types",
        "hono",
        "stripe"
      ]
    },
    "cli": {
      "entry": [
        "src/cli/main.ts",
        "tsup.config.ts",
        "scripts/*.{mjs,ts}",
        "scripts/lib/*.ts",
        "examples/agents/*.ts",
        "test/**/*.test.ts",
        "test/fixtures/**/*.ts"
      ],
      "project": [
        "src/**/*.ts",
        "scripts/**/*.{mjs,ts}",
        "examples/**/*.ts",
        "test/**/*.ts"
      ]
    },
    "agent-examples/*": {
      "entry": [
        "src/index.ts",
        "test/**/*.ts"
      ],
      "project": [
        "src/**/*.ts",
        "test/**/*.ts"
      ]
    }
  }
}
